# Copia este archivo a .env (setup.sh lo hace y genera contraseñas aleatorias).
# NUNCA subas .env al repositorio.

# --- PostgreSQL ---
POSTGRES_DB=commits_db
POSTGRES_USER=admin_ia
POSTGRES_PASSWORD=CAMBIAR_POSTGRES_PASSWORD
# Contraseña del rol de aplicación app_ia (solo SELECT/INSERT)
APP_DB_PASSWORD=CAMBIAR_APP_PASSWORD

# --- API ---
API_PORT=8000
LOG_LEVEL=INFO

# --- Ollama ---
# Modelos permitidos: gemma3:270m | qwen2.5:0.5b | qwen2.5-coder:1.5b
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=60
# Ejecución local (fuera de Docker):
OLLAMA_URL=http://localhost:11434/api/generate
# Ejecución en Docker (el contenedor llega al host):
OLLAMA_URL_DOCKER=http://host.docker.internal:11434/api/generate

# --- Solo ejecución local de la API (fuera de Docker) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=commits_db
DB_USER=app_ia
DB_PASSWORD=CAMBIAR_APP_PASSWORD
